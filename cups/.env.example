# Variable template for deploying the CUPS/AirPrint bridge on lab56.
# Image: https://hub.docker.com/r/drpsychick/airprint-bridge
#
# This file is a fallback for running `docker compose up -d` by hand only. In the real
# Komodo-driven deploy, CUPS_ADMIN_USER/CUPS_ADMIN_PASSWORD come from Komodo Variables
# ([[CUPS_ADMIN_USER]]/[[CUPS_ADMIN_PASSWORD]] interpolation in komodo/stacks/cups.toml,
# PASSWORD marked "secret"), and Komodo writes the resolved cups/.env itself at deploy
# time — editing the values below has no effect on that path. Copy to `.env` (NOT
# committed, see .gitignore) only if deploying manually outside Komodo.

## Image version is pinned directly in docker-compose.yml (not here) so Renovate can
## track and bump it — see the note in CLAUDE.md about deploy-only Renovate coverage.

CUPS_ADMIN_USER=admin
## CHANGE before deploying manually — this guards the CUPS web admin panel.
CUPS_ADMIN_PASSWORD=changeme

CUPS_WEBINTERFACE=yes
CUPS_SHARE_PRINTERS=yes
## LAN-only admin panel: network_mode: host binds it directly to lab56's LAN interface,
## and it must never get a cloudflared Public Hostname rule (plaintext-password admin UI).
CUPS_REMOTE_ADMIN=yes

CUPS_ACCESS_LOGLEVEL=config
CUPS_LOGLEVEL=warn
CUPS_ENV_DEBUG=no

## Leave blank to auto-detect — network_mode: host already binds to lab56's real interface.
CUPS_IP=
CUPS_HOSTNAME=

CUPS_SSL_CERT=
CUPS_SSL_KEY=

AVAHI_INTERFACES=
AVAHI_IPV6=no
AVAHI_REFLECTOR=no
AVAHI_REFLECT_IPV=no
