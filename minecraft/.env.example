TZ=Europe/Madrid

# Required by Mojang's EULA: https://aka.ms/MinecraftEULA
EULA=TRUE

TYPE=PURPUR
# LATEST re-resolves on every restart, which can also break if a plugin below has no build
# yet for the newly-resolved MC version. Pin an exact version once the world/plugins work.
VERSION=LATEST

MEMORY=4G

MAX_PLAYERS=10
DIFFICULTY=normal
MOTD=A Minecraft Server

# Auto-downloaded from Modrinth on startup — all work immediately with zero in-server setup:
# economy, claims (auto-earned claim blocks, no admin step), pre-generation, skills/mining
# (AuraSkills, free mcMMO alternative), health bar, spawner silk-touch, older-client support,
# proximity voice chat, player shops (created by players, not admins), anti-cheat.
MODRINTH_PROJECTS=essentialsx,vaultunlocked,griefprevention,chunky,auraskills,healthbar,silkspawners,viaversion,simple-voice-chat,quickshop-hikari,grimac

# RCON stays internal (25575 not published) — only used so the entrypoint can run
# RCON_CMDS_STARTUP against itself. Not a network-exposed secret, but still set via a
# Komodo Variable rather than a literal, per the hub's secrets convention.
ENABLE_RCON=true
RCON_PASSWORD=changeme

# Vanilla gamerule (no plugin): skips the night once half the online players are sleeping.
# chunky: kicks off world pre-generation on its own, no admin needs to run /chunky by hand.
RCON_CMDS_STARTUP="gamerule playersSleepingPercentage 50
chunky radius 2000
chunky start"
