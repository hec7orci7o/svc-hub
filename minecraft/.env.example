TZ=Europe/Madrid

# Required by Mojang's EULA: https://aka.ms/MinecraftEULA
EULA=TRUE

TYPE=MODRINTH
# https://modrinth.com/modpack/homestead — Fabric. MODRINTH_VERSION pins the exact pack
# release instead of LATEST so it can't silently jump to a newer build on a restart; VERSION
# pins the MC version that release requires, so a mismatched MODRINTH_VERSION bump later
# fails loudly instead of installing an incompatible MC version.
MODRINTH_MODPACK=homestead
MODRINTH_VERSION=1.3.7
VERSION=1.20.1

# time-control: day/night length isn't a vanilla gamerule, this mod adds one. Its actual
# config (day/night minutes) lives in minecraft/config/timecontrol.json, synced to
# /data/config on startup — see docker-compose.yml's ./config mount.
MODRINTH_PROJECTS=time-control

MEMORY=4G

MAX_PLAYERS=10
DIFFICULTY=normal
MOTD=A Minecraft Server

# RCON stays internal (25575 not published) — only used so the entrypoint can run
# RCON_CMDS_STARTUP against itself. Not a network-exposed secret, but still set via a
# Komodo Variable rather than a literal, per the hub's secrets convention.
ENABLE_RCON=true
RCON_PASSWORD=changeme

# Vanilla gamerule (no plugin): skips the night once half the online players are sleeping.
# chunky: kicks off world pre-generation on its own, no admin needs to run /chunky by hand.
RCON_CMDS_STARTUP="gamerule playersSleepingPercentage 50
chunky radius 2000
chunky start"
