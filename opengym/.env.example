# Passkeys are bound to this exact hostname — set it before anyone registers, changing it
# later invalidates existing credentials.
RP_ID=opengym.hectortoral.com
ORIGIN=https://opengym.hectortoral.com
WEB_PORT=8080
RP_NAME=openGym

# Signup is open until you close it — there's no admin yet to gate it at first boot. Right
# after first deploy: register your own profile, find your id in ./data/db.json ("users"[].id),
# set ADMIN_UIDS below, redeploy, then flip INVITE_ONLY=1 from the admin dashboard (Settings)
# so nobody else can self-register in the window before you do this.
#   ADMIN_UIDS=youruserid
#   INVITE_ONLY=1
