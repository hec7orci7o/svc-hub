# Variable template for deploying Komodo Core v2 on lab53.
# Copy to `.env` (NOT committed, see .gitignore) and fill in real values.
# Full variable list: https://github.com/moghtech/komodo/blob/main/config/core.config.toml
# and https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml

## Image version is pinned directly in docker-compose.yml (not here) so Renovate can
## track and bump it — see the note in CLAUDE.md about deploy-only Renovate coverage.
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

## Mongo credentials — CHANGE both before deploying
KOMODO_DATABASE_USERNAME=changeme
KOMODO_DATABASE_PASSWORD=changeme

TZ=Europe/Madrid

# --- Komodo Core ---

## lab53's LAN address. Not publicly reachable directly — the cloudflared/ tunnel on this
## same host is what fronts it publicly, if a Public Hostname rule is set for it.
KOMODO_HOST=http://lab53.local:9120
KOMODO_TITLE=svc-hub

KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
## No auto-created admin: the first user is created via the signup button in the UI.
# KOMODO_INIT_ADMIN_USERNAME=changeme
# KOMODO_INIT_ADMIN_PASSWORD=changeme

## Matches the "lab53" server already declared in komodo/servers.toml,
## so the ResourceSync recognizes it as the same resource instead of duplicating it.
KOMODO_FIRST_SERVER_NAME=lab53

## Used to sign (HMAC-SHA256, X-Hub-Signature-256) incoming GitHub webhooks.
## CHANGE to a random value (e.g. `openssl rand -hex 32`).
KOMODO_WEBHOOK_SECRET=changeme
## CHANGE to a random value (e.g. `openssl rand -hex 32`).
KOMODO_JWT_SECRET=changeme

## false so the first user can register via the signup button.
## Set back to true as soon as your account is created, so no one else can register.
KOMODO_DISABLE_USER_REGISTRATION=false

# --- Komodo Periphery (local instance on lab53) ---

PERIPHERY_CORE_ADDRESS=ws://core:9120
PERIPHERY_CONNECT_AS=${KOMODO_FIRST_SERVER_NAME}
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
PERIPHERY_ROOT_DIRECTORY=/etc/komodo
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
