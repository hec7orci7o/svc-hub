NODE_ENV=production
PORT=3000

# Generate with `openssl rand -hex 32`, avoid changing after first boot — encrypts stored
# secrets (API keys, MFA, SMTP, OIDC).
ENCRYPTION_KEY=changeme

TZ=Europe/Madrid
LOG_LEVEL=info
ALLOWED_ORIGINS=

APP_URL=https://trek.hectortoral.com

# Leaving both blank would make Trek print a random password to the container logs
# instead — set explicitly so the admin credential is a known Komodo Variable.
ADMIN_EMAIL=changeme
ADMIN_PASSWORD=changeme
