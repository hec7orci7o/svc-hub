NODE_ENV=production
PORT=3000

# Generate with `openssl rand -hex 32`, avoid changing after first boot — encrypts stored
# secrets (API keys, MFA, SMTP, OIDC).
ENCRYPTION_KEY=changeme

TZ=Europe/Madrid
LOG_LEVEL=info
ALLOWED_ORIGINS=

APP_URL=https://trek.hectortoral.com

# Leave both blank to get a random password printed to the container logs instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
