# Variable template for deploying TREK on lab54.
# Copy to `.env` (NOT committed, see .gitignore) and fill in real values.
# Docs: https://github.com/mauriceboe/TREK

## Image version is pinned directly in docker-compose.yml (not here) so Renovate can
## track and bump it — see the note in CLAUDE.md about deploy-only Renovate coverage.

NODE_ENV=production
PORT=3000

## CRITICAL: generate with `openssl rand -hex 32` and avoid changing after first boot —
## it encrypts stored secrets (API keys, MFA, SMTP, OIDC). Unlike n8n's key, TREK ships
## a documented rotation script if you ever do need to change it (see upstream README).
ENCRYPTION_KEY=changeme

TZ=Europe/Madrid
LOG_LEVEL=info
ALLOWED_ORIGINS=

## Direct LAN access by mDNS hostname. Public access, if enabled for this service, goes
## through the cloudflared/ tunnel on lab53 (Public Hostname rule), not through this host/port.
APP_URL=http://lab54.local:3000

## Sets the first admin account on first boot only (no effect once a user exists). Leave
## both blank to get a random password printed to the container logs instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
