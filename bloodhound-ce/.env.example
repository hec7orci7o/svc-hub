# Fallback for `docker compose up -d` by hand — Komodo writes bloodhound-ce/.env itself
# from komodo/stacks/bloodhound-ce.toml (see CLAUDE.md's "Secrets via Komodo Variables").
# Docs: https://bloodhound.specterops.io/

## Image versions are pinned in docker-compose.yml, not here — see CLAUDE.md.

POSTGRES_USER=bloodhound
POSTGRES_DB=bloodhound
## Generate with `openssl rand -base64 32`.
POSTGRES_PASSWORD=changeme

NEO4J_USER=neo4j
## Generate with `openssl rand -hex 32` — NOT -base64: NEO4J_AUTH is parsed as
## user/password, and a base64 value containing "/" breaks that (confirmed in production —
## see the note on graph-db in docker-compose.yml).
NEO4J_SECRET=changeme

## No env var needed for the admin login: BloodHound randomizes it on first boot and
## prints it to `docker compose logs bloodhound` ("Initial Password Set To: ...").
