POSTGRES_USER=reportcreator
POSTGRES_DB=reportcreator
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme

# Django secret key, `openssl rand -hex 64`. Rotating it just logs everyone out.
SECRET_KEY=changeme

# Encrypts findings/uploads at rest — https://docs.sysreptor.com/setup/configuration/#data-encryption-at-rest
# Losing every key listed makes existing encrypted data unrecoverable; rotate by adding a
# new key, never by replacing the only one.
# ENCRYPTION_KEYS='[{"id": "changeme-uuid", "key": "base64-32-byte-key", "cipher": "AES-GCM", "revoked": false}]'
# DEFAULT_ENCRYPTION_KEY_ID=changeme-uuid

DEBUG=off
