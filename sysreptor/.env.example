# Variable template for deploying SysReptor on lab58.
# Fallback for running `docker compose up -d` by hand only — the real Komodo deploy writes
# sysreptor/.env itself from komodo/stacks/sysreptor.toml (see CLAUDE.md's "Secrets via
# Komodo Variables"); editing values here has no effect on that path.
# Docs: https://docs.sysreptor.com/setup/configuration/
#
# No license key needed for community use — LICENSE is a Professional-tier-only env var,
# omitted here on purpose. Code license is "SysReptor Community License 1.1"
# (source-available, not an OSI-approved license).

## Image version is pinned directly in docker-compose.yml (not here) so Renovate can
## track and bump it — see the note in CLAUDE.md about deploy-only Renovate coverage.

POSTGRES_USER=reportcreator
POSTGRES_DB=reportcreator
## CHANGE before deploying — generate with `openssl rand -base64 32`.
POSTGRES_PASSWORD=changeme
## CHANGE before deploying — generate with `openssl rand -base64 32`.
REDIS_PASSWORD=changeme

## CRITICAL: generate with `openssl rand -hex 64` (Django secret key). Rotating it logs
## out every active session and invalidates pending password-reset links — annoying, not
## destructive, unlike ENCRYPTION_KEYS below.
SECRET_KEY=changeme

## CRITICAL: encrypts findings/uploaded files at rest — see
## https://docs.sysreptor.com/setup/configuration/#data-encryption-at-rest for the exact
## format. Unlike SECRET_KEY, losing every key listed here makes existing encrypted data
## permanently unrecoverable. Rotate by adding a new key to the list, never by replacing
## the only one.
# ENCRYPTION_KEYS='[{"id": "changeme-uuid", "key": "base64-32-byte-key", "cipher": "AES-GCM", "revoked": false}]'
# DEFAULT_ENCRYPTION_KEY_ID=changeme-uuid

DEBUG=off
