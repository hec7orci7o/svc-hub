POSTGRES_USER=infisical
POSTGRES_DB=infisical
# Generate with `openssl rand -hex 24` — hex-only so it can't break DB_CONNECTION_URI
# (a "@", ":" or "/" in the password would corrupt that URI).
POSTGRES_PASSWORD=changeme

# Generate with `openssl rand -hex 16` — never change after first boot, it decrypts
# already-stored secrets.
ENCRYPTION_KEY=changeme
# Generate with `openssl rand -base64 32` — signs JWT session tokens.
AUTH_SECRET=changeme
# Generate with `openssl rand -hex 24` — same URI-safety reason as POSTGRES_PASSWORD.
REDIS_PASSWORD=changeme

SITE_URL=https://infisical.hectortoral.com
