GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

N8N_HOST=n8n.hectortoral.com
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=https://n8n.hectortoral.com/
# Required behind a TLS-terminating proxy with PROTOCOL=http, or login cookies get dropped.
N8N_SECURE_COOKIE=false

# Generate with `openssl rand -hex 32`, never change after first boot — breaks decryption
# of already-saved credentials.
N8N_ENCRYPTION_KEY=changeme

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RESTRICT_FILE_ACCESS_TO=/files

N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_EXTERNAL=cheerio

NODE_ENV=production

# PASSWORD_HASH: bcrypt hash, e.g.
#   docker run --rm httpd:alpine htpasswd -bnBC 10 "" 'your-password' | cut -d: -f2
# n8n crash-loops on boot if this is missing or not valid bcrypt.
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=owner@example.com
N8N_INSTANCE_OWNER_FIRST_NAME=changeme
N8N_INSTANCE_OWNER_LAST_NAME=changeme
N8N_INSTANCE_OWNER_PASSWORD_HASH=changeme
