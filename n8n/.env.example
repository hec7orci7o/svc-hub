# Fallback for `docker compose up -d` by hand — Komodo writes n8n/.env itself from
# komodo/stacks/n8n.toml (see CLAUDE.md's "Secrets via Komodo Variables").
# Full reference: https://docs.n8n.io/hosting/configuration/environment-variables/

## Image version is pinned in docker-compose.yml, not here — see CLAUDE.md.

GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

## Public via cloudflared at this domain, not LAN-only. PROTOCOL stays http: cloudflared
## terminates TLS and forwards http internally.
N8N_HOST=n8n.hectortoral.com
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.hectortoral.com/
## Required alongside PROTOCOL=http behind a TLS-terminating proxy, or login cookies get
## the Secure flag and the browser drops them.
N8N_SECURE_COOKIE=false

## CRITICAL: generate with `openssl rand -hex 32`, never change after first boot — breaks
## decryption of already-saved credentials.
N8N_ENCRYPTION_KEY=changeme

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
## Restricts the "Read/Write Files from Disk" node to the ./local-files bind mount.
N8N_RESTRICT_FILE_ACCESS_TO=/files

## n8n v2 blocks Code-node env access and external npm packages by default; existing
## workflows rely on both being open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_EXTERNAL=cheerio

NODE_ENV=production

## SQLite is enough for a single instance; Postgres is only needed in queue mode with
## multiple workers.

## Pre-provisions the instance owner (n8n v2.17.0+) instead of the in-app signup UI.
## PASSWORD_HASH must be a bcrypt hash, not a plaintext password — generate with e.g.
## `docker run --rm httpd:alpine htpasswd -bnBC 10 "" 'your-password' | cut -d: -f2`.
## n8n crash-loops on boot if it's missing or invalid — confirm it's set before deploying.
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=owner@example.com
N8N_INSTANCE_OWNER_FIRST_NAME=changeme
N8N_INSTANCE_OWNER_LAST_NAME=changeme
N8N_INSTANCE_OWNER_PASSWORD_HASH=changeme
