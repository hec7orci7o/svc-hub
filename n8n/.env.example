# Variable template for deploying n8n on lab56.
# Full reference: https://docs.n8n.io/hosting/configuration/environment-variables/
#
# This file is a fallback for running `docker compose up -d` by hand only. In the real
# Komodo-driven deploy, N8N_ENCRYPTION_KEY comes from a Komodo Variable
# ([[N8N_ENCRYPTION_KEY]] interpolation in komodo/stacks/n8n.toml, marked "secret"), and
# Komodo writes the resolved n8n/.env itself at deploy time — editing the value below has
# no effect on that path. Copy to `.env` (NOT committed, see .gitignore) only if deploying
# manually outside Komodo.

## Image version is pinned directly in docker-compose.yml (not here) so Renovate can
## track and bump it — see the note in CLAUDE.md about deploy-only Renovate coverage.

GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

## Publicly exposed via the cloudflared/ tunnel on lab53 at this real domain — not
## LAN-only. PROTOCOL stays http: cloudflared terminates TLS and forwards http internally.
N8N_HOST=n8n.hectortoral.com
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.hectortoral.com/
## Required alongside PROTOCOL=http behind a TLS-terminating proxy, or login cookies get
## the Secure flag and the browser silently drops them over plain http.
N8N_SECURE_COOKIE=false

## CRITICAL: generate with `openssl rand -hex 32` and NEVER change after the first
## boot — it encrypts saved credentials; if lost or changed, existing workflows
## can no longer decrypt their credentials.
N8N_ENCRYPTION_KEY=changeme

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
## Required since recent n8n versions (runs the Code node in a separate process).
N8N_RUNNERS_ENABLED=true
## Restricts the "Read/Write Files from Disk" node to the ./local-files bind mount.
N8N_RESTRICT_FILE_ACCESS_TO=/files

## Existing workflows use env access and the cheerio package in Code nodes — n8n v2
## blocks both by default, so these stay explicit to avoid breaking them silently.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_EXTERNAL=cheerio

NODE_ENV=production

## SQLite is the default and is enough for a single instance (even n8n Cloud treats it
## this way on its Trial/Starter/Pro plans). Postgres is only needed in queue mode with
## multiple workers — not the case here. See https://docs.n8n.io/hosting/configuration/environment-variables/deployment/

## Pre-provisions the instance owner on first boot instead of n8n's in-app signup UI
## (n8n v2.17.0+). When true, n8n overwrites the owner details below on every restart
## and locks the UI/API from changing them. Real values are Komodo Variables
## ([[N8N_INSTANCE_OWNER_*]] in komodo/stacks/n8n.toml) — EMAIL/PASSWORD_HASH marked
## "secret". PASSWORD_HASH must be a bcrypt hash, NOT a plaintext password — generate
## with e.g. `htpasswd -bnBC 10 "" 'your-password' | cut -d: -f2`. EMAIL must match the
## email of whatever owner account already exists on this instance (n8n docs: this
## updates the existing owner, it doesn't create or merge accounts) — check Settings >
## Users in the current n8n UI first, don't invent an address.
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=owner@example.com
N8N_INSTANCE_OWNER_FIRST_NAME=changeme
N8N_INSTANCE_OWNER_LAST_NAME=changeme
N8N_INSTANCE_OWNER_PASSWORD_HASH=changeme
