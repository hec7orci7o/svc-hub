# Generate with: openssl rand -hex 32
GRAYLOG_PASSWORD_SECRET=changeme

# SHA256 hash of the admin password. Generate with: echo -n 'yourpassword' | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=changeme

# LAN IP of the server this stack deploys to, e.g. http://192.168.1.58:9000/
GRAYLOG_HTTP_EXTERNAL_URI=http://127.0.0.1:9000/
