# Cloudflare API token, scoped to Zone:DNS:Edit on the zone for DOMAIN below.
CF_DNS_API_TOKEN=changeme

# Let's Encrypt registration contact.
ACME_EMAIL=changeme

# Your real domain — routed hostnames in dynamic/routes.yml are <service>.$DOMAIN.
DOMAIN=changeme

# LAN CIDR allowed through the lan-only middleware (dynamic/middlewares.yml).
LAN_CIDR=changeme

# Backend targets for dynamic/routes.yml, as ip:port — not <board>.local, this container
# can't resolve mDNS.
N8N_BACKEND=changeme
SYSREPTOR_BACKEND=changeme
BLOODHOUND_BACKEND=changeme
ODOO_BACKEND=changeme
TREK_BACKEND=changeme
SCANOPY_BACKEND=changeme
ADGUARD_BACKEND=changeme   # port 8080, not 80/3000/443 — see adguard/docker-compose.yml
KOMODO_BACKEND=changeme
WORDPRESS_BACKEND=changeme   # port 8080 — see wordpress/docker-compose.yml
