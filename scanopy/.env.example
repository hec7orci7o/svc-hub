# Variable template for deploying scanopy on lab57.
# Copy to `.env` (NOT committed, see .gitignore) and fill in real values.
# Docs: https://github.com/scanopy/scanopy

## Image versions are pinned directly in docker-compose.yml (not here) so Renovate can
## track and bump them — see the note in CLAUDE.md about deploy-only Renovate coverage.

SCANOPY_LOG_LEVEL=info

## CHANGE before deploying — generate with `openssl rand -base64 32`.
POSTGRES_PASSWORD=changeme

## Direct LAN access by mDNS hostname. Public access, if enabled for this service, goes
## through the cloudflared/ tunnel on lab53 (Public Hostname rule), not through this host/port.
SCANOPY_PUBLIC_URL=http://lab57.local:60072
